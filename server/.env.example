# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (§3, models come in B1) ---
MONGODB_URI=your_mongodb_connection_string

# --- Auth (REQUIRED as of B2 — server will not boot without these) ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (REQUIRED as of B3 — uploads module is live) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Internal service auth (B5) ---
# Used by POST /vehicles/:id/location so the MVP simulator job (B6) can
# authenticate without a staff JWT. Generate any long random string.
# Optional at boot — that endpoint still works via a real staff JWT if this
# is unset, but the simulator (once built in B6) needs it.
INTERNAL_SERVICE_KEY=replace_with_a_long_random_string

# --- WhatsApp / Meta (§11, real webhook wired in B9) ---
WHATSAPP_VERIFY_TOKEN=your_meta_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# --- Vehicle simulator (B6) ---
# Requires INTERNAL_SERVICE_KEY above to be set, or it won't start at all.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=10
# Leave unset unless the process can't reach itself at localhost:PORT.
SIMULATOR_BASE_URL=
# Default center is the Vastrapur Lake area used in the contract's own
# examples (Ahmedabad) — override to simulate a different city.
SIMULATOR_CENTER_LNG=72.5714
SIMULATOR_CENTER_LAT=23.0225
SIMULATOR_RADIUS_KM=8

# --- Route optimization (B8) ---
# Leave unset to always use the phase1-nearest-neighbour fallback (fully
# supported — see RULES.md §9). Point at a running OSRM instance (its own
# base URL, e.g. http://localhost:5001) to use real road-network distances.
OSRM_BASE_URL=
OSRM_TIMEOUT_MS=4000
# Only used when OSRM isn't configured/reachable, to derive estimatedTimeMin.
ROUTE_AVERAGE_SPEED_KMPH=20

# --- Hotspot recalculation cron (B7) ---
HOTSPOT_RECALC_ENABLED=true
HOTSPOT_RECALC_CRON=*/15 * * * *
